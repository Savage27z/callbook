# --- Walrus Memory (mainnet) ---
# Create an agent at https://memory.walrus.xyz/dashboard. The delegate PRIVATE key goes here;
# the delegate PUBLIC key (shown under "Delegate keys") is the MEMWAL_AGENT_ID on the submission form.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=callbook

# --- Tatum (Sui mainnet GraphQL gateway; the gRPC endpoint is native gRPC and not usable from the SDK) ---
TATUM_API_KEY=
TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql

# --- Sui key that pays gas for sealing calls (needs a little SUI) ---
# suiprivkey1... bech32 string. Leave empty to run in labelled "simulated" seal mode.
SEALER_PRIVATE_KEY=

# Where the local ledger cache lives (a rebuildable index; Walrus is the source of truth)
CALLBOOK_DATA_DIR=./data

# Needed for every write (add voice/market, seal call, resolve). Reads stay public.
# If unset: writes are open in development and DISABLED in production.
ADMIN_TOKEN=

# Signs wallet-login session cookies. Keep it secret; changing it logs everyone out.
SESSION_SECRET=

# Demo limits so strangers cannot drain the operator funds: entries per wallet and number of wallets.
USER_MAX_EVENTS=40
MAX_USERS=60

# --- Shared state for serverless hosts like Vercel (leave empty locally; a JSON file is used instead) ---
# Create an Upstash Redis database from the Vercel Storage tab; these two variables are added for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
